<Window x:Class="ClassRollCall.Views.DesktopWidget"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Width="220"
        Height="340">

    <Window.Resources>
        <!-- 面板弹出动画：淡入 + 从上向下滑动 -->
        <Storyboard x:Key="PanelOpenStoryboard">
            <DoubleAnimation Storyboard.TargetName="CountPanel"
                             Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.2">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="PanelTranslate"
                             Storyboard.TargetProperty="Y"
                             From="-20" To="0" Duration="0:0:0.2">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <!-- 面板收起动画：淡出 -->
        <Storyboard x:Key="PanelCloseStoryboard">
            <DoubleAnimation Storyboard.TargetName="CountPanel"
                             Storyboard.TargetProperty="Opacity"
                             From="1" To="0" Duration="0:0:0.16">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </Window.Resources>

    <!-- 根布局：透明背景，面板在上，悬浮按钮在下 -->
    <Grid>
        <!-- ========== 向上弹出的功能面板 ========== -->
        <Border x:Name="CountPanel"
                VerticalAlignment="Top"
                HorizontalAlignment="Center"
                Width="200"
                Margin="10,20,10,0"
                CornerRadius="12"
                Background="#E6202020"
                BorderBrush="#33FFFFFF"
                BorderThickness="1"
                Padding="14"
                Opacity="0"
                Visibility="Collapsed"
                RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform>
                <TranslateTransform x:Name="PanelTranslate" Y="-20" />
            </Border.RenderTransform>
            <Border.Effect>
                <DropShadowEffect Color="#000000" Opacity="0.3" BlurRadius="16" ShadowDepth="0" />
            </Border.Effect>
            <StackPanel>
                <TextBlock Text="点名人数" Foreground="White" FontSize="12" Margin="0,0,0,10" />
                <!-- 快捷人数按钮行 -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <Border CornerRadius="6" Background="#2A2A2A" Width="36" Height="28" Margin="0,0,6,0">
                        <Button Content="1" Tag="1" Click="CountSelect_Click"
                                Background="Transparent" Foreground="White"
                                BorderThickness="0" Padding="0" />
                    </Border>
                    <Border CornerRadius="6" Background="#2A2A2A" Width="36" Height="28" Margin="0,0,6,0">
                        <Button Content="2" Tag="2" Click="CountSelect_Click"
                                Background="Transparent" Foreground="White"
                                BorderThickness="0" Padding="0" />
                    </Border>
                    <Border CornerRadius="6" Background="#2A2A2A" Width="36" Height="28" Margin="0,0,6,0">
                        <Button Content="3" Tag="3" Click="CountSelect_Click"
                                Background="Transparent" Foreground="White"
                                BorderThickness="0" Padding="0" />
                    </Border>
                    <Border CornerRadius="6" Background="#2A2A2A" Width="36" Height="28">
                        <Button Content="5" Tag="5" Click="CountSelect_Click"
                                Background="Transparent" Foreground="White"
                                BorderThickness="0" Padding="0" />
                    </Border>
                </StackPanel>
                <!-- 自定义人数输入 -->
                <Border CornerRadius="6" Background="#2A2A2A"
                        BorderBrush="#3A3A3A" BorderThickness="1" Margin="0,0,0,10">
                    <TextBox x:Name="CustomCountBox"
                             Text="1" Height="28"
                             Background="Transparent" Foreground="White"
                             BorderThickness="0" Padding="8,0"
                             VerticalContentAlignment="Center"
                             GotFocus="CustomCountBox_GotFocus"
                             TextChanged="CustomCountBox_TextChanged" />
                </Border>
                <!-- 底部操作按钮 -->
                <Button Content="打开主界面" Click="OpenMainWindow_Click"
                        Height="28" Background="Transparent" Foreground="#CCCCCC"
                        BorderThickness="0" HorizontalContentAlignment="Left" Padding="4,0" />
                <Button Content="关闭悬浮窗" Click="CloseWidget_Click"
                        Height="28" Background="Transparent" Foreground="#CCCCCC"
                        BorderThickness="0" HorizontalContentAlignment="Left" Padding="4,0" />
            </StackPanel>
        </Border>

        <!-- ========== 悬浮按钮主体（窗口右下角 64×64） ========== -->
        <Grid VerticalAlignment="Bottom"
              HorizontalAlignment="Right"
              Width="64" Height="64"
              Margin="0,0,10,10">

            <!-- 环绕进度条 -->
            <Path x:Name="ProgressPath"
                  Stroke="#0078D4"
                  StrokeThickness="2"
                  StrokeStartLineCap="Round"
                  StrokeEndLineCap="Round"
                  StrokeDashArray="0 216"
                  StrokeDashOffset="0"
                  Data="M 16,1 L 48,1 A 15,15 0 0 1 63,16 L 63,48 A 15,15 0 0 1 48,63 L 16,63 A 15,15 0 0 1 1,48 L 1,16 A 15,15 0 0 1 16,1 Z"
                  Visibility="Collapsed">
                <Path.RenderTransform>
                    <RotateTransform Angle="-90" CenterX="32" CenterY="32" />
                </Path.RenderTransform>
            </Path>

            <!-- 悬浮按钮外观 -->
            <Border x:Name="WidgetBody"
                    CornerRadius="16"
                    Background="#CC202020"
                    BorderBrush="#33FFFFFF"
                    BorderThickness="1"
                    Margin="2">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" Opacity="0.4"
                                      BlurRadius="12" ShadowDepth="0" />
                </Border.Effect>
                <TextBlock Text="点"
                           Foreground="White"
                           FontSize="24"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
            </Border>
        </Grid>
    </Grid>
</Window>
