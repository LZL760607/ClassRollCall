<Page x:Class="ClassRollCall.Views.Pages.StudentManagePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="学生管理"
      Background="{DynamicResource AppBackground}">
    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="学生名单管理"
                   FontSize="24" FontWeight="Light"
                   Foreground="{DynamicResource TextPrimary}"
                   Margin="0,0,0,20"/>

        <!-- 操作栏 -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,20">
            <Border CornerRadius="6"
                    Background="{DynamicResource CardBackground}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1">
                <TextBox x:Name="NameInput" Width="240" Height="36"
                         Background="Transparent"
                         Foreground="{DynamicResource TextPrimary}"
                         BorderThickness="0" Padding="10,0"
                         VerticalContentAlignment="Center"/>
            </Border>

            <Border CornerRadius="6" Margin="12,0,0,0">
                <Button Content="添加学生" Click="AddStudent_Click"
                        Width="100" Height="36"
                        Background="#0078D4" Foreground="White"
                        BorderThickness="0"/>
            </Border>

            <Border CornerRadius="6" Margin="8,0,0,0">
                <Button Content="删除选中" Click="RemoveStudent_Click"
                        Width="100" Height="36"
                        Background="{DynamicResource CardBackground}"
                        Foreground="{DynamicResource TextSecondary}"
                        BorderThickness="0"/>
            </Border>

            <Border CornerRadius="6" Margin="8,0,0,0">
                <Button Content="导入名单" Click="ImportList_Click"
                        Width="100" Height="36"
                        Background="{DynamicResource CardBackground}"
                        Foreground="{DynamicResource TextSecondary}"
                        BorderThickness="0"/>
            </Border>

            <Border CornerRadius="6" Margin="8,0,0,0">
                <Button Content="权重管理" Click="OpenWeight_Click"
                        Width="100" Height="36"
                        Background="{DynamicResource CardBackground}"
                        Foreground="{DynamicResource TextSecondary}"
                        BorderThickness="0"/>
            </Border>

            <Border CornerRadius="6" Margin="20,0,0,0">
                <Button Content="显示悬浮窗" Click="ShowWidget_Click"
                        Width="100" Height="36"
                        Background="{DynamicResource CardBackground}"
                        Foreground="{DynamicResource TextSecondary}"
                        BorderThickness="0"/>
            </Border>
        </StackPanel>

        <!-- 学生列表 -->
        <Border Grid.Row="2" CornerRadius="8"
                Background="{DynamicResource CardBackground}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1">
            <ListBox x:Name="StudentList"
                     Background="Transparent"
                     Foreground="{DynamicResource TextPrimary}"
                     BorderThickness="0" Padding="12"
                     DisplayMemberPath="Name"/>
        </Border>
    </Grid>
</Page>
