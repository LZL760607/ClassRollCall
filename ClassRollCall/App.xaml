<Application x:Class="ClassRollCall.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:local="clr-namespace:ClassRollCall">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>

            <local:InvertBoolConverter x:Key="InvertBoolConverter" />

            <SolidColorBrush x:Key="AppBackground" Color="#202020" />
            <SolidColorBrush x:Key="CardBackground" Color="#2A2A2A" />
            <SolidColorBrush x:Key="BorderBrush" Color="#3A3A3A" />
            <SolidColorBrush x:Key="TextPrimary" Color="#FFFFFF" />
            <SolidColorBrush x:Key="TextSecondary" Color="#AAAAAA" />
            <SolidColorBrush x:Key="SidebarBackground" Color="#1A1A1A" />
            <SolidColorBrush x:Key="AccentColor" Color="#0078D4" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
