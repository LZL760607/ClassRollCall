<Window x:Class="ClassRollCall.Views.StyledDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Width="480" Height="320"
        Topmost="True"
        ShowInTaskbar="False">
    <Window.Resources>
        <Storyboard x:Key="FadeInStoryboard">
            <DoubleAnimation Storyboard.TargetName="RootBorder"
                             Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.2">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </Window.Resources>

    <Border x:Name="RootBorder"
            CornerRadius="12"
            BorderThickness="1"
            Opacity="0"
            Background="#EE1E1E1E"
            BorderBrush="#30FFFFFF">
        <Border.Effect>
            <DropShadowEffect Color="#000000" Opacity="0.5"
                              BlurRadius="36" ShadowDepth="0" />
        </Border.Effect>

        <Grid Margin="32,28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 标题 -->
            <StackPanel Grid.Row="0" Orientation="Horizontal">
                <TextBlock Text="⚡" FontSize="28"
                           VerticalAlignment="Center" Margin="0,0,12,0" />
                <TextBlock x:Name="TitleText"
                           Text="高度公平模式"
                           Foreground="White"
                           FontSize="22"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />
            </StackPanel>

            <TextBlock Grid.Row="0"
                       Text="Enhanced Fair Mode"
                       Foreground="#60FFFFFF"
                       FontSize="12"
                       FontWeight="Light"
                       Margin="52,34,0,0" />

            <!-- 内容 -->
            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          Margin="0,16,0,12">
                <TextBlock x:Name="ContentText"
                           Foreground="#B0FFFFFF"
                           FontSize="13"
                           LineHeight="22"
                           TextWrapping="Wrap" />
            </ScrollViewer>

            <!-- 按钮 -->
            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,8,0,0">
                <Button x:Name="CancelButton"
                        Content="取 消"
                        Width="90" Height="34"
                        Background="Transparent"
                        Foreground="#90FFFFFF"
                        BorderBrush="#30FFFFFF"
                        BorderThickness="1"
                        FontSize="13"
                        Margin="0,0,12,0"
                        Click="CancelButton_Click" />
                <Button x:Name="ConfirmButton"
                        Content="确 定"
                        Width="90" Height="34"
                        Background="#0078D4"
                        Foreground="White"
                        BorderThickness="0"
                        FontSize="13"
                        Margin="12,0,0,0"
                        Click="ConfirmButton_Click" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
