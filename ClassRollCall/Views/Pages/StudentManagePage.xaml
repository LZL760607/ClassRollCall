<Page x:Class="ClassRollCall.Views.Pages.StudentManagePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="学生管理"
      Background="{DynamicResource AppBackground}">
    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="学生名单管理"
                   FontSize="24" FontWeight="Light"
                   Foreground="{DynamicResource TextPrimary}"
                   Margin="0,0,0,20"/>

        <!-- 操作栏 -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,20">
            <Border CornerRadius="6"
                    Background="{DynamicResource CardBackground}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1">
                <TextBox x:Name="NameInput" Width="240" Height="36"
                         Background="Transparent"
                         Foreground="{DynamicResource TextPrimary}"
                         BorderThickness="0" Padding="10,0"
                         VerticalContentAlignment="Center"
                         TextChanged="NameInput_TextChanged"
                         KeyDown="NameInput_KeyDown"/>
            </Border>

            <Border CornerRadius="6" Margin="12,0,0,0">
                <Button Content="添加学生" Click="AddStudent_Click"
                        Width="100" Height="36"
                        Background="#0078D4" Foreground="White"
                        BorderThickness="0"/>
            </Border>

            <Border CornerRadius="6" Margin="8,0,0,0">
                <Button Content="删除选中" Click="RemoveStudent_Click"
                        Width="100" Height="36"
                        Background="{DynamicResource CardBackground}"
                        Foreground="{DynamicResource TextSecondary}"
                        BorderThickness="0"/>
            </Border>

            <Border CornerRadius="6" Margin="8,0,0,0">
                <Button Content="导入名单" Click="ImportList_Click"
                        Width="100" Height="36"
                        Background="{DynamicResource CardBackground}"
                        Foreground="{DynamicResource TextSecondary}"
                        BorderThickness="0"/>
            </Border>

            <Border CornerRadius="6" Margin="20,0,0,0">
                <Button Content="显示悬浮窗" Click="ShowWidget_Click"
                        Width="100" Height="36"
                        Background="{DynamicResource CardBackground}"
                        Foreground="{DynamicResource TextSecondary}"
                        BorderThickness="0"/>
            </Border>
        </StackPanel>

        <!-- 学生列表 + 密码面板 -->
        <Grid Grid.Row="2">
            <Border CornerRadius="8"
                    Background="{DynamicResource CardBackground}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1">
                <ListBox x:Name="StudentList"
                         Background="Transparent"
                         Foreground="{DynamicResource TextPrimary}"
                         BorderThickness="0" Padding="12"
                         DisplayMemberPath="Name"/>
            </Border>

            <!-- 密码面板（从底部弹出） -->
            <Border x:Name="PasswordPanel"
                    CornerRadius="8"
                    Background="#E02A2A2A"
                    BorderBrush="#40FFFFFF"
                    BorderThickness="1"
                    Width="300" Height="160"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    Opacity="0"
                    Visibility="Collapsed"
                    RenderTransformOrigin="0.5,1">
                <Border.RenderTransform>
                    <ScaleTransform x:Name="PanelScale" ScaleX="1" ScaleY="0"/>
                </Border.RenderTransform>
                <Border.Effect>
                    <DropShadowEffect Color="#000000" Opacity="0.4"
                                      BlurRadius="20" ShadowDepth="0"/>
                </Border.Effect>
                <StackPanel VerticalAlignment="Center" Margin="24,0">
                    <TextBlock Text="请输入管理密码"
                               Foreground="White"
                               FontSize="16"
                               FontWeight="Light"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,16"/>
                    <Border CornerRadius="6"
                            Background="#1AFFFFFF"
                            BorderBrush="#30FFFFFF"
                            BorderThickness="1"
                            Margin="0,0,0,12">
                        <PasswordBox x:Name="PasswordBox"
                                     Height="36"
                                     Background="Transparent"
                                     Foreground="White"
                                     BorderThickness="0"
                                     Padding="10,0"
                                     VerticalContentAlignment="Center"
                                     KeyDown="PasswordBox_KeyDown"/>
                    </Border>
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center">
                        <Button Content="确 认"
                                Width="80" Height="32"
                                Background="#0078D4"
                                Foreground="White"
                                BorderThickness="0"
                                Click="ConfirmPassword_Click"/>
                        <Button Content="取 消"
                                Width="80" Height="32"
                                Background="Transparent"
                                Foreground="#AAAAAA"
                                BorderThickness="0"
                                Margin="12,0,0,0"
                                Click="CancelPassword_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
