<Window x:Class="ClassRollCall.Views.WeightManageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="权重管理"
        Width="560" Height="480"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBackground}"
        Topmost="True">

    <Window.Resources>
        <Style x:Key="LockButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="ToolTip" Value="点击切换锁定状态" />
            <Setter Property="Foreground" Value="#00CC6A" />
            <Setter Property="Content" Value="🔓" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsWeightLocked}" Value="True">
                    <Setter Property="Foreground" Value="#E81123" />
                    <Setter Property="Content" Value="🔒" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="权重管理"
                           FontSize="20" FontWeight="Light"
                           Foreground="{DynamicResource TextPrimary}" />
                <TextBlock Text="🔓 绿色 = 权重自由浮动 ｜ 🔒 红色 = 权重锁定不变"
                           FontSize="12"
                           Foreground="{DynamicResource TextSecondary}"
                           Margin="0,4,0,0" />
            </StackPanel>
            <Button Grid.Column="1" Content="重置全部"
                    Width="80" Height="30"
                    Background="{DynamicResource CardBackground}"
                    Foreground="{DynamicResource TextSecondary}"
                    BorderThickness="0" VerticalAlignment="Top"
                    Click="ResetAll_Click" />
        </Grid>

        <!-- 滑块列表 -->
        <Border Grid.Row="1" CornerRadius="8"
                Background="{DynamicResource CardBackground}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1">
            <ListBox x:Name="WeightList"
                     Background="Transparent"
                     Foreground="{DynamicResource TextPrimary}"
                     BorderThickness="0" Padding="8"
                     HorizontalContentAlignment="Stretch"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Height="44" Margin="4,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" MinWidth="60" />
                                <ColumnDefinition Width="*" MinWidth="80" />
                                <ColumnDefinition Width="Auto" MinWidth="30" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="{Binding Name}"
                                       Foreground="{DynamicResource TextPrimary}"
                                       VerticalAlignment="Center" FontSize="14"
                                       Margin="0,0,10,0" />

                            <Slider Grid.Column="1"
                                    Minimum="0.1"
                                    Maximum="{Binding RelativeSource={RelativeSource AncestorType=Window},
                                              Path=MaxWeight}"
                                    Value="{Binding Weight, Mode=TwoWay}"
                                    VerticalAlignment="Center" Margin="0,0,8,0" />

                            <TextBlock Grid.Column="2"
                                       Text="{Binding Weight, StringFormat={}{0:F1}}"
                                       Foreground="{DynamicResource TextSecondary}"
                                       VerticalAlignment="Center" FontSize="13"
                                       Margin="0,0,10,0" />

                            <Button Grid.Column="3"
                                    Style="{StaticResource LockButtonStyle}"
                                    Tag="{Binding Name}"
                                    Click="ToggleLock_Click" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
    </Grid>
</Window>
