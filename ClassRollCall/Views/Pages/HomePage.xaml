<Page x:Class="ClassRollCall.Views.Pages.HomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="点名"
      Background="{DynamicResource AppBackground}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="随机点名"
                   FontSize="24" FontWeight="Light"
                   Foreground="{DynamicResource TextPrimary}"
                   Margin="40,32,40,0"/>

        <StackPanel Grid.Row="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
            <!-- 滚动显示区 -->
            <Border CornerRadius="16"
                    Background="{DynamicResource CardBackground}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" Padding="80,48">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" Opacity="0.3"
                                      BlurRadius="20" ShadowDepth="0"/>
                </Border.Effect>
                <TextBlock x:Name="RollText" Text="点击下方按钮开始点名"
                           FontSize="28"
                           Foreground="{DynamicResource TextSecondary}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"/>
            </Border>

            <!-- 开始按钮 -->
            <Border CornerRadius="8" Margin="0,40,0,0"
                    HorizontalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect Color="#0078D4" Opacity="0.3"
                                      BlurRadius="12" ShadowDepth="0"/>
                </Border.Effect>
                <Button x:Name="StartBtn" Content="开始点名"
                        Click="StartRoll_Click"
                        Width="180" Height="44"
                        Background="#0078D4" Foreground="White"
                        BorderThickness="0" FontSize="15"/>
            </Border>
        </StackPanel>
    </Grid>
</Page>
