<Page x:Class="ClassRollCall.Views.Pages.HomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="点名"
      Background="{DynamicResource AppBackground}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="随机点名"
                   FontSize="24" FontWeight="Light"
                   Foreground="{DynamicResource TextPrimary}"
                   Margin="40,32,40,0"/>

        <StackPanel Grid.Row="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
            <!-- 滚动显示区 -->
            <Border CornerRadius="16"
                    Background="{DynamicResource CardBackground}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" Padding="80,48">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" Opacity="0.3"
                                      BlurRadius="20" ShadowDepth="0"/>
                </Border.Effect>
                <TextBlock x:Name="RollText" Text="等待开始"
                           FontSize="48"
                           Foreground="{DynamicResource TextSecondary}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Border>

            <!-- 高度公平模式开关 -->
            <Border CornerRadius="8"
                    Background="{DynamicResource CardBackground}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    Padding="14" Margin="0,16,0,0" Width="400">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="高度公平模式"
                               Foreground="{DynamicResource TextPrimary}"
                               FontSize="13"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Margin="0,0,12,0" />
                    <ui:ToggleSwitch Grid.Column="1"
                                     x:Name="FairModeSwitch"
                                     HorizontalAlignment="Left"
                                     Checked="FairMode_Checked"
                                     Unchecked="FairMode_Unchecked" />
                </Grid>
            </Border>

            <!-- 公式展示（仅开启时可见） -->
            <Border x:Name="FairFormulaPanel"
                    CornerRadius="8"
                    Background="{DynamicResource AppBackground}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    Padding="14" Margin="0,8,0,0" Width="400"
                    Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="高度公平模式 · 算法公式"
                               Foreground="{DynamicResource TextPrimary}"
                               FontSize="12" FontWeight="SemiBold"
                               Margin="0,0,0,6" />
                    <TextBlock Foreground="{DynamicResource TextSecondary}"
                               FontSize="11" FontFamily="Consolas"
                               LineHeight="18">
                        <Run Text="EFM(n) = Vote(" Foreground="{DynamicResource TextSecondary}" />
                        <Run Text="FY(S, seed₁)" Foreground="#0078D4" />
                        <Run Text=", " Foreground="{DynamicResource TextSecondary}" />
                        <Run Text="FY(S, seed₂)" Foreground="#0078D4" />
                        <Run Text=", " Foreground="{DynamicResource TextSecondary}" />
                        <Run Text="FY(S, seed₃)" Foreground="#0078D4" />
                        <Run Text=")" Foreground="{DynamicResource TextSecondary}" />
                    </TextBlock>
                    <TextBlock Foreground="{DynamicResource TextSecondary}"
                               FontSize="10" Margin="0,4,0,0" TextWrapping="Wrap">
                        S=学生集合(权重强制=1) ｜ FY=Fisher-Yates洗牌<LineBreak/>
                        seedₖ=SHA256(Guid+Ticks+k) ｜ Vote=多数投票<LineBreak/>
                        迭代3轮·独立种子·去重展示
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- 开始按钮 -->
            <Border CornerRadius="8" Margin="0,24,0,0"
                    HorizontalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect Color="#0078D4" Opacity="0.3"
                                      BlurRadius="12" ShadowDepth="0"/>
                </Border.Effect>
                <Button x:Name="StartBtn" Content="开始点名"
                        Click="StartRoll_Click"
                        Width="180" Height="44"
                        Background="#0078D4" Foreground="White"
                        BorderThickness="0" FontSize="15"/>
            </Border>
        </StackPanel>

        <!-- 结果弹窗蒙层 -->
        <Grid x:Name="ResultMask" Background="#80000000"
              Visibility="Collapsed"
              MouseLeftButtonDown="ResultMask_MouseDown">
            <Border x:Name="ResultPanel"
                    Background="{DynamicResource CardBackground}"
                    BorderBrush="#40FFFFFF" BorderThickness="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Width="0" Height="4">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" Opacity="0.5"
                                      BlurRadius="30" ShadowDepth="0"/>
                </Border.Effect>
                <Grid Opacity="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="点名结果"
                               Foreground="{DynamicResource TextSecondary}"
                               FontSize="14"
                               HorizontalAlignment="Center"
                               Margin="0,20,0,0"/>
                    <TextBlock Grid.Row="1" x:Name="ResultText"
                               Foreground="{DynamicResource TextPrimary}"
                               FontSize="42" FontWeight="Medium"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Margin="0,12,0,28"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
