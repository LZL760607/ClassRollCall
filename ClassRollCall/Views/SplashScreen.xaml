<Window x:Class="ClassRollCall.Views.SplashScreen"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Width="420"
        Height="220"
        ShowInTaskbar="False">

    <Window.Resources>
        <Storyboard x:Key="FadeInStoryboard">
            <DoubleAnimation Storyboard.TargetName="RootBorder"
                             Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.35">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <!-- 旋转环动画：1.2秒一圈，无限循环 -->
        <Storyboard x:Key="SpinnerStoryboard" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="SpinnerRotate"
                             Storyboard.TargetProperty="Angle"
                             From="0" To="360" Duration="0:0:1.2" />
        </Storyboard>

        <Storyboard x:Key="ProgressStoryboard" Completed="OnProgressCompleted">
            <DoubleAnimation Storyboard.TargetName="LoadingProgress"
                             Storyboard.TargetProperty="Value"
                             From="0" To="100" Duration="0:0:1.5">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </Window.Resources>

    <Border x:Name="RootBorder"
            CornerRadius="10"
            BorderThickness="1"
            Opacity="0"
            Background="#E8202020"
            BorderBrush="#20FFFFFF">
        <Border.Effect>
            <DropShadowEffect Color="#000000" Opacity="0.45"
                              BlurRadius="30" ShadowDepth="0" />
        </Border.Effect>

        <Grid Margin="32,28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 标题 -->
            <TextBlock Grid.Row="0"
                       Text="ClassRollCall"
                       Foreground="White"
                       FontSize="26"
                       FontWeight="Light"
                       HorizontalAlignment="Center" />

            <TextBlock Grid.Row="0"
                       Text="Loading,Please wait"
                       Foreground="#99FFFFFF"
                       FontSize="13"
                       FontWeight="Light"
                       HorizontalAlignment="Center"
                       Margin="0,38,0,0" />

            <!-- 加载环 + 文字 -->
            <StackPanel Grid.Row="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Margin="0,12,0,0">
                <Grid Width="24" Height="24">
                    <!-- 底色环 -->
                    <Ellipse Width="24" Height="24"
                             Stroke="#20FFFFFF" StrokeThickness="2.5" />
                    <!-- 旋转环 -->
                    <Ellipse Width="24" Height="24"
                             Stroke="#0078D4" StrokeThickness="2.5"
                             StrokeStartLineCap="Round"
                             StrokeEndLineCap="Round"
                             StrokeDashArray="22 140"
                             RenderTransformOrigin="0.5,0.5">
                        <Ellipse.RenderTransform>
                            <RotateTransform x:Name="SpinnerRotate" Angle="0" />
                        </Ellipse.RenderTransform>
                    </Ellipse>
                </Grid>
                <TextBlock Text="Starting up..."
                           Foreground="#B0FFFFFF"
                           FontSize="14"
                           FontWeight="Light"
                           Margin="10,0,0,0"
                           VerticalAlignment="Center" />
            </StackPanel>

            <!-- 进度条 -->
            <ProgressBar Grid.Row="2"
                         x:Name="LoadingProgress"
                         Minimum="0" Maximum="100" Value="0"
                         Height="6"
                         Foreground="#0078D4"
                         Background="#15FFFFFF"
                         BorderThickness="0"
                         Margin="0,16,0,0" />
        </Grid>
    </Border>
</Window>
